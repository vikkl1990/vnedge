# VNEDGE configuration — copy to .env and edit. NEVER commit .env.
# Exchange credentials, when an optional CLI needs them, must never have
# withdrawal permission and should be IP-restricted. The default stack is keyless.

# --- Mode ------------------------------------------------------------------
# backtest | paper | shadow | live_small | live_full | emergency_reduce_only
VNEDGE_TRADING_MODE=backtest
# Live orders require THREE gates: a live_* mode, this flag, AND the exact
# confirmation phrase below. Any one missing -> no real orders, ever.
VNEDGE_LIVE_TRADING_ENABLED=false
VNEDGE_CONFIRM_LIVE_TRADING=
# To go live (after the pre-live checklist passes), set:
# VNEDGE_CONFIRM_LIVE_TRADING=I_UNDERSTAND_THIS_IS_HIGH_RISK
VNEDGE_LIVE_SMALL_CAPITAL_CAP_USD=100

# --- Default measurement/paper runtime ------------------------------------
# Required by Docker Compose. Generate a high-entropy value; never put it in
# a URL. The browser exchanges it once for an HttpOnly session cookie.
DASHBOARD_TOKEN=
# Optional per-user credentials: name:token:role[:expiry_iso];...
DASHBOARD_USERS=
# Public-data measurement lanes. No exchange credentials are required.
MULTI_LANE_EXCHANGES=binanceusdm,bybit,delta_india
MULTI_LANE_SYMBOLS=BTC/USDT:USDT
MULTI_LANE_TIMEFRAME=1h
# Empty/off is intentional. A PAPER capital lane requires BOTH values and a
# registered, capital-eligible ID. The default measurement lanes cannot signal.
MULTI_LANE_CAPITAL_ENABLED=0
MULTI_LANE_CAPITAL_STRATEGY=
MULTI_LANE_CAPITAL_EXCHANGE=binanceusdm
MULTI_LANE_CAPITAL_SYMBOL=BTC/USDT:USDT
MULTI_LANE_CAPITAL_TIMEFRAME=1h

# Optional live-data, virtual-outcome-only structure lane. Both enable and
# strategy are required. This never grants PAPER/LIVE permission.
MULTI_LANE_SHADOW_OBSERVE_ENABLED=0
MULTI_LANE_SHADOW_OBSERVE_STRATEGY=
MULTI_LANE_SHADOW_OBSERVE_EXCHANGE=binanceusdm
MULTI_LANE_SHADOW_OBSERVE_SYMBOL=BTC/USDT:USDT
MULTI_LANE_SHADOW_OBSERVE_TIMEFRAME=1h
MULTI_LANE_SHADOW_OBSERVE_EQUITY=500
MULTI_LANE_SHADOW_OBSERVE_DAILY_LOSS_USD=10
MULTI_LANE_SHADOW_OBSERVE_TRAIL_ATR_MULT=0

# --- Risk (see src/vnedge/config/risk_config.py for meaning of each) -------
VNEDGE_RISK__MAX_DAILY_LOSS_USD=20
VNEDGE_RISK__RISK_PER_TRADE_PCT=1.0
VNEDGE_RISK__MAX_LEVERAGE_PER_POSITION=5
# Setting leverage above 10 also requires:
# VNEDGE_RISK__ACKNOWLEDGE_HIGH_LEVERAGE=true
VNEDGE_RISK__MAX_EFFECTIVE_ACCOUNT_LEVERAGE=2.0
VNEDGE_RISK__MAX_OPEN_POSITIONS=2
VNEDGE_RISK__MAX_DRAWDOWN_PCT=15
VNEDGE_RISK__MIN_ACCOUNT_EQUITY_USD=100

# --- Optional operator-CLI exchange keys -----------------------------------
# SHADOW TRADING (real data, no real orders): market data is PUBLIC/keyless —
# the trial already runs on real mainnet prices. Keys only add real-equity
# sizing. For that, use READ-ONLY keys: on Binance enable "Reading" ONLY,
# NOT trading, NOT withdrawals. The read-only account provider has no
# create_order path, so no order can ever reach the exchange.
# These are not consumed by the default Compose stack. Live EXECUTION uses
# production endpoints only: dry-run/shadow first, then a
# bounded mainnet drill, then live_small. Testnet/sandbox data is not accepted
# as production execution evidence. Any real order still needs trade-only keys
# plus all three live gates. No live service is deployed by Compose.
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

DELTA_API_KEY=
DELTA_API_SECRET=

# --- Alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Browser sessions and encrypted Settings credentials. Generate both values
# with a password manager or cryptographically secure local tool; never commit
# the populated .env file. VNEDGE_SECRETS_KEY must be a Fernet key.
DASHBOARD_JWT_SECRET=
DASHBOARD_COOKIE_SECURE=true
VNEDGE_SECRETS_KEY=
VNEDGE_SECRETS_KEY_VERSION=1
