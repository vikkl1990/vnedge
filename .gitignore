# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data & runtime state (anchored to root — src/vnedge/data is source code).
# Exclude data CONTENTS but keep the AI strategy sandbox tracked: AI-authored
# strategy SOURCE is validated code (not market data) and never trades — it is
# a research candidate. Re-inclusion must step through each parent dir.
/data/*
!/data/strategies
/data/strategies/*
!/data/strategies/ai
/logs/
*.parquet
*.db
KILL
/research/live_research/*
!/research/live_research/README.md
/research/evidence_bundles/*
!/research/evidence_bundles/README.md

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code local session settings
.claude/settings.local.json

# ML model registry artifacts
/models/
deploy/certs/
research/experiments/
research/htf_data/
research/universe/
# Arena materializes these three bounded templates at runtime. Immutable
# source/spec copies are captured in research evidence, not deployment dirt.
/data/strategies/ai/auto_arena_ema_pullback_21_100_v1.py
/data/strategies/ai/auto_arena_ema_pullback_21_100_v1.experiment.json
/data/strategies/ai/auto_arena_ema_pullback_30_120_v1.py
/data/strategies/ai/auto_arena_ema_pullback_30_120_v1.experiment.json
