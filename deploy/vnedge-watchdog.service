[Unit]
Description=VNEDGE bounded service health recovery (no trading authority)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/vnedge
ExecStart=/usr/bin/python3 /home/ubuntu/vnedge/scripts/service_watchdog.py --apply
TimeoutStartSec=180
NoNewPrivileges=true
